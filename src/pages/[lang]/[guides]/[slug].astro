---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { CATEGORIES, taxonomyUrl } from '../../../lib/catalog';
import { GUIDES } from '../../../lib/guides';
import { guideUrl, route } from '../../../lib/site';
import type { Guide } from '../../../lib/guides';
import type { Locale } from '../../../lib/types';

export const prerender = true;
export function getStaticPaths() {
  return (['it', 'en'] as const).flatMap((locale) => GUIDES.map((guide) => ({
    params: { lang: locale, guides: locale === 'it' ? 'guide' : 'guides', slug: guide.slug[locale] },
    props: { locale, guide },
  })));
}
interface Props { locale: Locale; guide: Guide }
const { locale, guide } = Astro.props;
const isIt = locale === 'it';
const other: Locale = isIt ? 'en' : 'it';
const r = route(locale);
const canonicalPath = guideUrl(locale, guide.slug[locale]);
const alternateUrl = guideUrl(other, guide.slug[other]);
const selectedCategories = CATEGORIES.filter((category) => guide.categoryIds.includes(category.id));
const structuredData = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'TechArticle', headline: guide.title[locale], description: guide.description[locale], inLanguage: locale, author: { '@type': 'Organization', name: 'FullMuscle Equipment', url: new URL(r.home, Astro.site) }, publisher: { '@type': 'Organization', name: 'FullMuscle Equipment', logo: { '@type': 'ImageObject', url: new URL('/brand/fullmuscle-mark.svg', Astro.site) } }, mainEntityOfPage: new URL(canonicalPath, Astro.site) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(r.home, Astro.site) },
      { '@type': 'ListItem', position: 2, name: isIt ? 'Guide' : 'Guides', item: new URL(`${r.guides}/`, Astro.site) },
      { '@type': 'ListItem', position: 3, name: guide.title[locale], item: new URL(canonicalPath, Astro.site) },
    ] },
  ],
};
---
<BaseLayout locale={locale} title={`${guide.title[locale]} | FullMuscle`} description={guide.description[locale]} canonicalPath={canonicalPath} alternateUrl={alternateUrl} structuredData={structuredData}>
  <article>
    <header class="guide-hero surface-dark"><div class="shell guide-hero-inner"><Breadcrumbs items={[{ label: 'Home', href: r.home }, { label: isIt ? 'Guide' : 'Guides', href: `${r.guides}/` }, { label: guide.title[locale] }]} /><p class="eyebrow">{guide.readingTime} {isIt ? 'minuti di lettura' : 'minute read'}</p><h1>{guide.title[locale]}</h1><p class="lead">{guide.intro[locale]}</p></div></header>
    <div class="shell guide-layout">
      <div class="guide-body">
        {guide.sections.map((section, index) => <section><span>0{index + 1}</span><h2>{section.title[locale]}</h2>{section.paragraphs[locale].map((paragraph) => <p>{paragraph}</p>)}{section.points && <ul>{section.points[locale].map((point) => <li>{point}</li>)}</ul>}</section>)}
      </div>
      <aside><p class="eyebrow">{isIt ? 'Categorie collegate' : 'Related categories'}</p>{selectedCategories.map((category) => <a href={taxonomyUrl(locale, category, 'category')}><strong>{category.name[locale]}</strong><span>{category.count} {isIt ? 'modelli' : 'models'} →</span></a>)}<a class="button" href={r.quote}>{isIt ? 'Richiedi un preventivo' : 'Request a quotation'}</a></aside>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-hero{padding:2rem 0 clamp(4rem,8vw,7rem)}.guide-hero-inner h1{max-width:18ch;margin:2rem 0 1.5rem;font-size:clamp(2.8rem,6vw,5.7rem);letter-spacing:-.06em;line-height:.96}.guide-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:clamp(3rem,8vw,8rem);padding-block:clamp(4rem,8vw,8rem)}.guide-body{max-width:760px}.guide-body section+section{margin-top:4rem;padding-top:4rem;border-top:1px solid var(--line)}.guide-body section>span{color:var(--green-dark);font-size:.75rem;font-weight:850}.guide-body h2{margin:.7rem 0 1.25rem;font-size:clamp(2rem,4vw,3.3rem);letter-spacing:-.05em;line-height:1}.guide-body p{color:#475149;font-size:1.08rem}.guide-body ul{display:grid;gap:.65rem;margin:1.5rem 0 0;padding:1.25rem 1.25rem 1.25rem 2.5rem;border-radius:1rem;background:#e9ede9}.guide-layout aside{position:sticky;top:7rem;align-self:start;display:grid;gap:.65rem;border-radius:1.2rem;padding:1.25rem;background:#fff}.guide-layout aside>a:not(.button){display:grid;gap:.2rem;border-top:1px solid var(--line);padding:.9rem 0}.guide-layout aside span{color:var(--muted);font-size:.75rem}.guide-layout aside .button{margin-top:.5rem}@media(max-width:850px){.guide-layout{grid-template-columns:1fr}.guide-layout aside{position:static}}
</style>
