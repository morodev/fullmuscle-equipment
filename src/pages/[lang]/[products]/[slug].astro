---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import AddToQuote from '../../../components/react/AddToQuote';
import { CATEGORY_BY_ID, LINE_BY_ID, PRODUCTS, listItem, productsForCategory, taxonomyUrl } from '../../../lib/catalog';
import { guideUrl, productUrl, route } from '../../../lib/site';
import { ui } from '../../../lib/i18n';
import type { CatalogProduct, Locale } from '../../../lib/types';

export const prerender = true;
export function getStaticPaths() {
  return (['it', 'en'] as const).flatMap((locale) => PRODUCTS.map((product) => ({
    params: { lang: locale, products: locale === 'it' ? 'prodotti' : 'products', slug: product.slug[locale] },
    props: { locale, product },
  })));
}
interface Props { locale: Locale; product: CatalogProduct }
const { locale, product } = Astro.props;
const isIt = locale === 'it';
const other: Locale = isIt ? 'en' : 'it';
const t = ui(locale);
const r = route(locale);
const category = CATEGORY_BY_ID.get(product.categoryId)!;
const line = product.lineId ? LINE_BY_ID.get(product.lineId) : undefined;
const related = productsForCategory(product.categoryId).filter((candidate) => candidate.sku !== product.sku).slice(0, 3);
const canonicalPath = productUrl(locale, product.slug[locale]);
const breadcrumbSchema = {
  '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(r.home, Astro.site) },
    { '@type': 'ListItem', position: 2, name: t.catalog, item: new URL(r.catalog, Astro.site) },
    { '@type': 'ListItem', position: 3, name: category.name[locale], item: new URL(taxonomyUrl(locale, category, 'category'), Astro.site) },
    { '@type': 'ListItem', position: 4, name: product.name[locale], item: new URL(canonicalPath, Astro.site) },
  ],
};
const structuredData = {
  '@context': 'https://schema.org', '@graph': [breadcrumbSchema, {
    '@type': 'Product', name: product.name[locale], sku: product.sku, image: [new URL(product.primaryImage, Astro.site), ...product.gallery.map((image) => new URL(image, Astro.site))],
    description: product.summary[locale], brand: { '@type': 'Brand', name: 'FullMuscle Equipment' }, category: category.name[locale], url: new URL(canonicalPath, Astro.site),
    additionalProperty: product.specifications[locale].map((specification) => ({ '@type': 'PropertyValue', name: specification.label, value: specification.value })),
  }],
};
const title = product.seoTitle[locale];
const metaDescription = product.seoDescription[locale];
const productTypeName = product.name[locale].endsWith(product.sku)
  ? product.name[locale].slice(0, -product.sku.length).trimEnd()
  : product.name[locale];
---
<BaseLayout locale={locale} title={title} description={metaDescription} canonicalPath={canonicalPath} alternateUrl={productUrl(other, product.slug[other])} image={product.primaryImage} imageAlt={product.imageAlt[locale]} structuredData={structuredData}>
  <div class="shell"><Breadcrumbs items={[{ label: 'Home', href: r.home }, { label: t.catalog, href: r.catalog }, { label: category.name[locale], href: taxonomyUrl(locale, category, 'category') }, { label: product.name[locale] }]} /></div>
  <article class="product-page" data-pagefind-body data-pagefind-filter={`category:${category.name[locale]}`}>
    <section class="shell product-intro">
      <div class="product-gallery">
        <div class="primary-image">
          <img src={product.primaryImage} alt={product.imageAlt[locale]} width="900" height="900" fetchpriority="high" />
        </div>
        {product.gallery.length > 0 && <div class="gallery-strip">{product.gallery.map((image, index) => <img src={image} alt={`${product.name[locale]} · ${index + 2}`} width="240" height="240" loading="lazy" />)}</div>}
      </div>
      <div class="product-copy">
        <p class="eyebrow">{category.name[locale]}</p>
        <div class="sku">{product.sku}</div>
        <h1>{productTypeName} <span class="product-name-sku">{product.sku}</span></h1>
        <p class="product-summary">{product.summary[locale]}</p>
        {line && <a class="line-pill" href={taxonomyUrl(locale, line, 'line')}>{line.name[locale]} →</a>}
        <div class="quote-panel">
          <p>{isIt ? 'Inserisci il prodotto nella tua lista. Puoi aggiungere più attrezzature e inviare un’unica richiesta.' : 'Add this product to your list. You can select multiple items and send one request.'}</p>
          <AddToQuote client:load sku={product.sku} label={t.add} addedLabel={t.added} />
        </div>
      </div>
    </section>

    <section class="section-tight product-details">
      <div class="shell details-grid">
        <div class="prose"><p class="eyebrow">{isIt ? 'Panoramica' : 'Overview'}</p><h2>{isIt ? 'Progettata per il lavoro professionale.' : 'Designed for professional training.'}</h2>{product.description[locale].map((paragraph) => <p>{paragraph}</p>)}</div>
        <div class="features-panel"><p class="eyebrow">{t.features}</p><ul>{product.features[locale].map((feature) => <li>{feature}</li>)}</ul></div>
      </div>
    </section>

    {product.specifications[locale].length > 0 && <section class="section-tight surface-white"><div class="shell specs"><div><p class="eyebrow">{t.specifications}</p><h2>{isIt ? 'Dati del modello' : 'Model data'}</h2><p>{isIt ? 'Le specifiche saranno confermate nella proposta commerciale in base alla configurazione scelta.' : 'Specifications will be confirmed in the commercial proposal according to the selected configuration.'}</p></div><dl>{product.specifications[locale].map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl></div></section>}

    <section class="section-tight project-fit">
      <div class="shell details-grid">
        <div><p class="eyebrow">{isIt ? 'Prima del preventivo' : 'Before the quotation'}</p><h2>{isIt ? 'Valuta il modello nel progetto completo.' : 'Evaluate the model within the complete project.'}</h2><p>{isIt ? 'Ingombri, percorsi e combinazione tra le aree incidono quanto la scelta della singola macchina.' : 'Footprint, circulation and the balance between training areas matter as much as the individual machine.'}</p></div>
        <div><ul>{product.selectionNotes[locale].map((note) => <li>{note}</li>)}</ul><div class="project-links"><a class="text-link" href={guideUrl(locale, isIt ? 'attrezzature-apertura-nuova-palestra' : 'choosing-equipment-for-a-new-gym')}>{isIt ? 'Guida alla scelta delle attrezzature' : 'Guide to choosing gym equipment'} →</a><a class="text-link" href={`${r.solutions}/${isIt ? 'apertura-nuova-palestra' : 'new-gym-opening'}/`}>{isIt ? 'Supporto per una nuova palestra' : 'Support for a new gym'} →</a></div></div>
      </div>
    </section>

    <section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">{t.related}</p><h2>{isIt ? 'Completa la tua selezione.' : 'Complete your selection.'}</h2></div><a class="text-link" href={taxonomyUrl(locale, category, 'category')}>{isIt ? 'Tutta la categoria' : 'Full category'} →</a></div><div class="grid grid-3">{related.map((item) => <ProductCard product={listItem(item, locale)} locale={locale} />)}</div></div></section>
  </article>
</BaseLayout>

<style>
  .product-intro { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(320px,.95fr); gap: clamp(2rem,6vw,6rem); padding: 2rem 0 6rem; align-items: center; }
  .primary-image { position: relative; overflow: hidden; aspect-ratio: 1; border-radius: 1.75rem; background: #fff; box-shadow: 0 24px 70px rgba(8,13,9,.08); }
  .primary-image img { width: 100%; height: 100%; object-fit: contain; }
  .gallery-strip { display: grid; grid-template-columns: repeat(4,1fr); gap: .65rem; margin-top: .65rem; }
  .gallery-strip img { width: 100%; aspect-ratio: 1; object-fit: contain; border: 1px solid var(--line); border-radius: .8rem; background: #fff; }
  .product-copy { position: relative; }
  .product-copy .sku { color: var(--muted); font-size: .78rem; font-weight: 850; letter-spacing: .12em; }
  .product-copy h1 { max-width: 14ch; margin: .55rem 0 1.2rem; font-size: clamp(2.6rem,5.6vw,5.2rem); letter-spacing: -.06em; line-height: .95; }
  .product-name-sku { white-space: nowrap; }
  .product-summary { max-width: 53ch; color: #4e5950; font-size: 1.12rem; }
  .line-pill { display: inline-flex; margin-top: .75rem; border-bottom: 1px solid var(--green-dark); color: var(--green-dark); font-size: .8rem; font-weight: 800; }
  .quote-panel { margin-top: 2rem; padding: 1.25rem; border-radius: 1.15rem; background: var(--ink); color: #fff; }
  .quote-panel p { margin: 0 0 1rem; color: #aeb7b0; font-size: .85rem; }
  .product-details { background: #e9ede9; }
  .details-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(3rem,8vw,8rem); }
  .prose h2, .specs h2 { margin: 0 0 1rem; font-size: clamp(2rem,4vw,3.6rem); letter-spacing: -.05em; line-height: 1; }
  .features-panel { align-self: start; border-radius: 1.5rem; padding: 1.75rem; background: var(--ink); color: #fff; }
  .features-panel ul { margin: 0; padding: 0; list-style: none; }
  .features-panel li { padding: .85rem 0; border-top: 1px solid #303732; color: #d5dbd6; font-size: .9rem; }
  .project-fit { background: #e9ede9; }
  .project-fit h2 { max-width: 15ch; margin: 0 0 1rem; font-size: clamp(2rem,4vw,3.6rem); letter-spacing: -.05em; line-height: 1; }
  .project-fit p { color: var(--muted); }
  .project-fit ul { margin: 0; padding: 0; list-style: none; }
  .project-fit li { padding: .9rem 0; border-top: 1px solid #cbd3cc; }
  .project-fit li::before { margin-right: .65rem; color: var(--green-dark); content: '✓'; font-weight: 900; }
  .project-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 1.5rem; }
  .specs { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(3rem,8vw,8rem); }
  .specs > div > p:last-child { color: var(--muted); }
  .specs dl { margin: 0; border-top: 1px solid var(--line); }
  .specs dl div { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .specs dt { color: var(--muted); font-size: .82rem; }
  .specs dd { margin: 0; font-size: .88rem; font-weight: 700; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .section-heading h2 { margin: 0; font-size: clamp(2rem,4vw,3.5rem); letter-spacing: -.05em; }
  @media(max-width:850px){.product-intro,.details-grid,.specs{grid-template-columns:1fr}.product-intro{padding-bottom:4rem}.specs{gap:2rem}}
  @media(max-width:560px){.product-copy h1{max-width:none;font-size:2.55rem}.specs dl div{grid-template-columns:1fr}.section-heading{align-items:flex-start;flex-direction:column}}
</style>
