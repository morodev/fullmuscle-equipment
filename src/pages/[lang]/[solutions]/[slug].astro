---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { CATEGORY_BY_ID, taxonomyUrl } from '../../../lib/catalog';
import { guideUrl, route } from '../../../lib/site';
import { SOLUTIONS, SOLUTION_BY_ID, solutionUrl, solutionsHubUrl } from '../../../lib/solutions';
import type { SolutionId } from '../../../lib/solutions';
import type { Locale } from '../../../lib/types';

export const prerender = true;

export function getStaticPaths() {
  return (['it', 'en'] as const).flatMap((locale) => SOLUTIONS.map((solution) => ({
    params: { lang: locale, solutions: locale === 'it' ? 'soluzioni' : 'solutions', slug: solution.slug[locale] },
    props: { locale, solutionId: solution.id },
  })));
}

interface Props { locale: Locale; solutionId: SolutionId }
const { locale, solutionId } = Astro.props;
const solution = SOLUTION_BY_ID.get(solutionId)!;
const isIt = locale === 'it';
const other: Locale = isIt ? 'en' : 'it';
const r = route(locale);
const canonicalPath = solutionUrl(locale, solution);
const selectedCategories = solution.categoryIds.map((id) => CATEGORY_BY_ID.get(id)).filter((category) => category !== undefined);
const relatedGuideSlug = solution.id === 'new-gym'
  ? { it: 'attrezzature-apertura-nuova-palestra', en: 'choosing-equipment-for-a-new-gym' }
  : { it: 'come-organizzare-sala-pesi-professionale', en: 'how-to-plan-a-professional-gym-floor' };
const quoteUrl = `${r.quote}?project=${solution.quoteType}`;
const structuredData = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebPage', name: solution.metaTitle[locale], description: solution.metaDescription[locale], url: new URL(canonicalPath, Astro.site), primaryImageOfPage: { '@type': 'ImageObject', url: new URL(solution.image.src, Astro.site) } },
    { '@type': 'Service', name: solution.name[locale], description: solution.intro[locale], provider: { '@type': 'Organization', name: 'FullMuscle Equipment', url: new URL(r.home, Astro.site) }, areaServed: ['IT', 'Europe'], url: new URL(canonicalPath, Astro.site) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(r.home, Astro.site) },
      { '@type': 'ListItem', position: 2, name: isIt ? 'Soluzioni' : 'Solutions', item: new URL(solutionsHubUrl(locale), Astro.site) },
      { '@type': 'ListItem', position: 3, name: solution.name[locale], item: new URL(canonicalPath, Astro.site) },
    ] },
  ],
};
---
<BaseLayout locale={locale} title={solution.metaTitle[locale]} description={solution.metaDescription[locale]} canonicalPath={canonicalPath} alternateUrl={solutionUrl(other, solution)} image={solution.image.src} imageAlt={solution.imageAlt[locale]} structuredData={structuredData}>
  <header class="solution-hero surface-dark">
    <div class="solution-hero-media">
      <Image src={solution.image} alt={solution.imageAlt[locale]} widths={[720, 1080, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <span aria-hidden="true"></span>
    </div>
    <div class="shell solution-hero-inner">
      <Breadcrumbs items={[{ label: 'Home', href: r.home }, { label: isIt ? 'Soluzioni' : 'Solutions', href: solutionsHubUrl(locale) }, { label: solution.name[locale] }]} />
      <div class="solution-hero-copy">
        <p class="eyebrow">{solution.eyebrow[locale]}</p>
        <h1>{solution.title[locale]}</h1>
        <p>{solution.intro[locale]}</p>
        <div class="hero-actions"><a class="button" href={quoteUrl}>{isIt ? 'Parliamo del progetto' : 'Discuss your project'} →</a><a class="button button-secondary" href={r.catalog}>{isIt ? 'Esplora il catalogo' : 'Explore catalogue'}</a></div>
      </div>
    </div>
  </header>

  <section class="section"><div class="shell solution-intro"><div><p class="eyebrow">{isIt ? 'Il punto di partenza' : 'Where we start'}</p><h2 class="section-title">{isIt ? 'Prima il progetto. Poi le macchine.' : 'The project comes before the equipment.'}</h2></div><p>{solution.challenge[locale]}</p></div></section>

  <section class="section-tight surface-white"><div class="shell"><p class="eyebrow">{isIt ? 'Come lavoriamo' : 'How we work'}</p><div class="grid grid-3 steps">{solution.steps.map((step,index)=><article><span>0{index+1}</span><h2>{step.title[locale]}</h2><p>{step.text[locale]}</p></article>)}</div></div></section>

  <section class="section solution-checks"><div class="shell solution-intro"><div><p class="eyebrow">{isIt ? 'Le domande del progetto' : 'Project questions'}</p><h2 class="section-title">{isIt ? 'Prima di scegliere i modelli, definiamo i criteri.' : 'Define the criteria before choosing models.'}</h2><a class="text-link" href={guideUrl(locale, relatedGuideSlug[locale])}>{isIt ? 'Approfondisci nella guida tecnica' : 'Read the technical guide'} →</a></div><ol>{solution.checks.map((check, index) => <li><span>0{index + 1}</span><p>{check[locale]}</p></li>)}</ol></div></section>

  <section class="section"><div class="shell"><div class="solution-intro"><div><p class="eyebrow">{isIt ? 'Costruisci la dotazione' : 'Build your equipment mix'}</p><h2 class="section-title">{isIt ? 'Le aree da cui iniziare.' : 'The areas to start from.'}</h2></div><p>{isIt ? 'Una prima selezione di famiglie da adattare a dimensioni, capacità e obiettivi del tuo progetto.' : 'An initial selection of equipment families to adapt around the size, capacity and goals of your project.'}</p></div><div class="grid grid-3 category-links">{selectedCategories.map((category)=><a class="taxonomy-card" href={taxonomyUrl(locale,category,'category')}><strong>{category.name[locale]}</strong><p>{category.description[locale]}</p><span class="link-label">{isIt?'Vedi i prodotti →':'View products →'}</span><span class="count">{category.count}</span></a>)}</div></div></section>

  <section class="section-tight final"><div class="shell final-inner"><div><p class="eyebrow">FullMuscle Equipment</p><h2>{isIt ? 'Raccontaci lo spazio che vuoi costruire.' : 'Tell us about the space you want to build.'}</h2></div><a class="button button-dark" href={quoteUrl}>{isIt ? 'Richiedi un confronto' : 'Request a consultation'} →</a></div></section>
</BaseLayout>

<style>
  .solution-hero{position:relative;min-height:min(820px,calc(100vh - 5rem));overflow:hidden}.solution-hero-media{position:absolute;inset:0}.solution-hero-media :global(img){width:100%;height:100%;object-fit:cover}.solution-hero-media>span{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,10,8,.95) 0%,rgba(7,10,8,.78) 42%,rgba(7,10,8,.18) 78%),linear-gradient(0deg,rgba(7,10,8,.55),transparent 52%)}.solution-hero-inner{position:relative;z-index:1;display:flex;min-height:min(820px,calc(100vh - 5rem));flex-direction:column;padding-block:1.25rem 5rem}.solution-hero-copy{max-width:780px;margin-top:auto}.solution-hero h1{max-width:14ch;margin:.5rem 0 1.25rem;font-size:clamp(3rem,7vw,7rem);letter-spacing:-.065em;line-height:.9}.solution-hero-copy>p:not(.eyebrow){max-width:58ch;color:#d3dad4;font-size:clamp(1.05rem,1.8vw,1.3rem)}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.solution-intro{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);align-items:end}.solution-intro>p{margin:0;color:#475149;font-size:clamp(1.1rem,2vw,1.4rem)}.steps article{min-height:15rem;padding:1.5rem;border-left:2px solid var(--green);background:var(--paper)}.steps span{color:var(--green-dark);font-size:.75rem;font-weight:850}.steps h2{margin:2.5rem 0 .75rem;font-size:1.45rem}.steps p{color:var(--muted)}.solution-checks{background:#e9ede9}.solution-checks .text-link{display:inline-block;margin-top:1.5rem}.solution-checks ol{margin:0;padding:0;list-style:none}.solution-checks li{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1rem 0;border-top:1px solid #cbd3cc}.solution-checks li>span{color:var(--green-dark);font-size:.75rem;font-weight:850}.solution-checks li p{margin:0;color:#39443b}.category-links{margin-top:2.5rem}.final{background:var(--green)}.final .eyebrow{color:var(--ink)}.final-inner{display:flex;align-items:center;justify-content:space-between;gap:2rem}.final h2{max-width:17ch;margin:0;font-size:clamp(2rem,5vw,4rem);letter-spacing:-.05em;line-height:1}@media(max-width:760px){.solution-hero,.solution-hero-inner{min-height:690px}.solution-hero-media>span{background:linear-gradient(0deg,rgba(7,10,8,.96) 0%,rgba(7,10,8,.62) 72%,rgba(7,10,8,.25) 100%)}.solution-hero h1{font-size:clamp(2.8rem,13vw,4.6rem)}.solution-intro{grid-template-columns:1fr}.final-inner{align-items:flex-start;flex-direction:column}.final .button{width:auto}}
</style>
