---
import ProductCard from './ProductCard.astro';
import type { CatalogListItem, Locale } from '../lib/types';
import { paginatedUrl } from '../lib/site';
import { ui } from '../lib/i18n';

interface FilterLink { id: string; name: string; href: string }
interface Props {
  products: CatalogListItem[];
  categories: FilterLink[];
  lines: FilterLink[];
  locale: Locale;
  total: number;
  currentPage: number;
  pageCount: number;
  baseUrl: string;
  activeCategory?: string;
  activeLine?: string;
}
const { products, categories, lines, locale, total, currentPage, pageCount, baseUrl, activeCategory, activeLine } = Astro.props;
const t = ui(locale);
const isIt = locale === 'it';
const visiblePages = Array.from({ length: pageCount }, (_, index) => index + 1).filter((page) => Math.abs(page - currentPage) <= 2 || page === 1 || page === pageCount);
---
<div class="catalog-listing">
  <div class="catalog-toolbar" aria-label={isIt ? 'Esplora il catalogo' : 'Explore the catalogue'} data-catalog-toolbar>
    <button class="catalog-search" type="button" data-search-open>
      <span aria-hidden="true">⌕</span>{t.search}
    </button>
    <details data-catalog-filter>
      <summary>{activeCategory ? categories.find((item) => item.id === activeCategory)?.name : t.allCategories}</summary>
      <nav aria-label={t.allCategories}>
        <a href={locale === 'it' ? '/it/catalogo/' : '/en/catalogue/'}>{t.allCategories}</a>
        {categories.map((item) => <a class:list={{ active: item.id === activeCategory }} href={item.href}>{item.name}</a>)}
      </nav>
    </details>
    <details data-catalog-filter>
      <summary>{activeLine ? lines.find((item) => item.id === activeLine)?.name : t.allLines}</summary>
      <nav aria-label={t.allLines}>
        <a href={locale === 'it' ? '/it/catalogo/' : '/en/catalogue/'}>{t.allLines}</a>
        {lines.map((item) => <a class:list={{ active: item.id === activeLine }} href={item.href}>{item.name}</a>)}
      </nav>
    </details>
  </div>

  <div class="catalog-result-meta"><strong>{total}</strong> {t.results} · {isIt ? 'pagina' : 'page'} {currentPage} {isIt ? 'di' : 'of'} {pageCount}</div>
  <div class="catalog-product-grid">
    {products.map((product, index) => <ProductCard product={product} locale={locale} headingLevel="h2" eager={index < 4} />)}
  </div>

  {pageCount > 1 && <nav class="pagination" aria-label={isIt ? 'Paginazione prodotti' : 'Product pagination'}>
    {currentPage > 1
      ? <a class="page-direction" href={paginatedUrl(baseUrl, locale, currentPage - 1)}>← {t.previous}</a>
      : <span class="page-direction disabled">← {t.previous}</span>}
    <div class="page-numbers">
      {visiblePages.map((page) => <a class:list={{ current: page === currentPage }} aria-current={page === currentPage ? 'page' : undefined} href={paginatedUrl(baseUrl, locale, page)}>{page}</a>)}
    </div>
    {currentPage < pageCount
      ? <a class="page-direction" href={paginatedUrl(baseUrl, locale, currentPage + 1)}>{t.next} →</a>
      : <span class="page-direction disabled">{t.next} →</span>}
  </nav>}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-catalog-toolbar]').forEach((toolbar) => {
    const filters = Array.from(toolbar.querySelectorAll<HTMLDetailsElement>('[data-catalog-filter]'));

    filters.forEach((filter) => {
      filter.addEventListener('toggle', () => {
        if (!filter.open) return;
        filters.forEach((other) => {
          if (other !== filter) other.open = false;
        });
      });
    });

    toolbar.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openFilter = filters.find((filter) => filter.open);
      if (!openFilter) return;
      openFilter.open = false;
      openFilter.querySelector<HTMLElement>('summary')?.focus();
      event.preventDefault();
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !toolbar.contains(event.target)) {
        filters.forEach((filter) => { filter.open = false; });
      }
    });
  });
</script>

<style>
  .catalog-toolbar{position:sticky;z-index:10;top:5.75rem;display:grid;grid-template-columns:2fr 1fr 1fr;gap:.75rem;margin-bottom:1.25rem;padding:.85rem;border:1px solid #dce2dc;border-radius:1rem;background:rgba(245,247,244,.96);box-shadow:0 12px 35px rgba(9,12,10,.07);backdrop-filter:blur(12px)}
  .catalog-search,.catalog-toolbar summary{display:flex;min-height:3.2rem;align-items:center;gap:.6rem;width:100%;border:1px solid #cbd3cc;border-radius:.8rem;padding:.75rem .9rem;background:#fff;color:var(--ink);font-size:.88rem;text-align:left}.catalog-search span{color:var(--green-dark);font-size:1.4rem}.catalog-toolbar details{position:relative}.catalog-toolbar summary{justify-content:space-between;cursor:pointer;list-style:none}.catalog-toolbar summary::-webkit-details-marker{display:none}.catalog-toolbar summary::after{content:'⌄';color:var(--green-dark)}.catalog-toolbar nav{position:absolute;z-index:20;top:calc(100% + .4rem);right:0;display:grid;width:min(80vw,310px);max-height:22rem;overflow:auto;border:1px solid #d6ddd7;border-radius:.8rem;padding:.45rem;background:#fff;box-shadow:0 18px 45px rgba(9,12,10,.15)}.catalog-toolbar nav a{padding:.55rem .7rem;border-radius:.5rem;color:#475149;font-size:.8rem}.catalog-toolbar nav a:hover,.catalog-toolbar nav a.active{background:#eaf3e4;color:#245d12}.catalog-result-meta{margin:0 0 1.25rem;color:#657067;font-size:.85rem}.catalog-result-meta strong{color:#090c0a;font-size:1.1rem}.catalog-product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.pagination{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;margin-top:2.5rem}.page-direction{font-size:.8rem;font-weight:800}.page-direction:last-child{text-align:right}.page-direction.disabled{color:#9da69f}.page-numbers{display:flex;align-items:center;justify-content:center;gap:.35rem}.page-numbers a{display:grid;width:2.5rem;height:2.5rem;place-items:center;border:1px solid #cad2cb;border-radius:50%;background:#fff;font-size:.78rem;font-weight:800}.page-numbers a.current{border-color:var(--green);background:var(--green);color:var(--ink)}
  @media(max-width:900px){.catalog-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.catalog-toolbar{grid-template-columns:1fr 1fr}.catalog-search{grid-column:1/-1}}
  @media(max-width:620px){.catalog-product-grid{grid-template-columns:1fr}.catalog-toolbar{position:relative;z-index:30;grid-template-columns:1fr}.catalog-search{grid-column:auto}.catalog-toolbar nav{position:static;width:100%;max-height:min(55vh,22rem);margin-top:.4rem}.pagination{grid-template-columns:1fr 1fr}.page-numbers{grid-column:1/-1;grid-row:1}.page-direction{grid-row:2}.page-numbers a{width:2.25rem;height:2.25rem}}
</style>
