---
import type { Locale } from '../lib/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
const isIt = locale === 'it';
---
<button class="search-trigger" type="button" aria-label={isIt ? 'Cerca nel sito' : 'Search website'} data-search-open>⌕</button>
<dialog class="search-dialog" data-search-dialog>
  <div class="search-shell">
    <div class="search-top"><span>{isIt ? 'Ricerca FullMuscle' : 'Search FullMuscle'}</span><button type="button" aria-label={isIt ? 'Chiudi' : 'Close'} data-search-close>×</button></div>
    <label><span>{isIt ? 'Cerca prodotti, categorie e soluzioni' : 'Search products, categories and solutions'}</span><input type="search" placeholder={isIt ? 'Es. chest press, tapis roulant…' : 'E.g. chest press, treadmill…'} data-search-input /></label>
    <div class="search-results" aria-live="polite" data-search-results><p>{isIt ? 'Scrivi almeno due caratteri.' : 'Enter at least two characters.'}</p></div>
  </div>
</dialog>

<script is:inline define:vars={{ locale, emptyLabel: isIt ? 'Nessun risultato.' : 'No results.', hintLabel: isIt ? 'Scrivi almeno due caratteri.' : 'Enter at least two characters.', errorLabel: isIt ? 'La ricerca sarà disponibile dopo la build del sito.' : 'Search will be available after the site build.' }}>
  const dialog = document.querySelector('[data-search-dialog]');
  const close = document.querySelector('[data-search-close]');
  const input = document.querySelector('[data-search-input]');
  const results = document.querySelector('[data-search-results]');
  let timer;
  if (dialog instanceof HTMLDialogElement) document.body.append(dialog);
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-search-open]')) return;
    dialog?.showModal();
    setTimeout(() => input?.focus(), 20);
  });
  close?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  input?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(async () => {
      const query = input.value.trim();
      if (query.length < 2) { results.innerHTML = `<p>${hintLabel}</p>`; return; }
      try {
        const pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        const search = await pagefind.search(query);
        const resolved = await Promise.all(search.results.slice(0, 24).map((item) => item.data()));
        const localized = resolved.filter((item) => item.url.startsWith(`/${locale}/`)).slice(0, 8);
        results.innerHTML = localized.length ? localized.map((item) => `<a href="${item.url}"><strong>${item.meta.title}</strong><span>${item.excerpt}</span></a>`).join('') : `<p>${emptyLabel}</p>`;
      } catch { results.innerHTML = `<p>${errorLabel}</p>`; }
    }, 180);
  });
</script>

<style>
  .search-trigger{display:grid;width:2.4rem;height:2.4rem;place-items:center;border:1px solid #3a433b;border-radius:50%;background:transparent;color:#fff;font-size:1.35rem}.search-trigger:hover{border-color:var(--green);color:var(--green)}.search-dialog{width:min(100% - 1.5rem,780px);max-height:80vh;margin:6rem auto auto;border:1px solid #333b34;border-radius:1.4rem;padding:0;background:var(--ink);color:#fff;box-shadow:0 30px 100px rgba(0,0,0,.55)}.search-dialog::backdrop{background:rgba(5,8,6,.72);backdrop-filter:blur(8px)}.search-shell{padding:1.25rem}.search-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;color:var(--green);font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.search-top button{border:0;background:transparent;color:#fff;font-size:2rem;line-height:1}.search-shell label>span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.search-shell input{width:100%;min-height:4rem;border:1px solid #3b443d;border-radius:1rem;padding:1rem 1.2rem;background:#151a16;color:#fff;font-size:1.1rem}.search-results{display:grid;gap:.4rem;margin-top:1rem;overflow:auto}.search-results :global(a){display:grid;gap:.25rem;padding:1rem;border-radius:.8rem;background:#141915}.search-results :global(a:hover){background:#1d251e}.search-results :global(strong){font-size:.95rem}.search-results :global(span),.search-results p{margin:0;color:#9da69f;font-size:.78rem}.search-results :global(mark){background:var(--green);color:var(--ink)}@media(max-width:860px){.search-trigger{width:3rem;height:3rem}.search-dialog{margin-top:1rem}}
</style>
