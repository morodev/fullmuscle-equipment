---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import hero5201 from '../assets/home/FM-5201.png';
import hero5204 from '../assets/home/FM-5204.png';
import heroMP8144 from '../assets/home/FM-MP-8144.png';
import ProductCard from './ProductCard.astro';
import SolutionCard from './SolutionCard.astro';
import { CATEGORIES, LINES, PRODUCTS, HOME_FEATURED_PRODUCTS, HOME_HERO_PRODUCTS, listItem, taxonomyUrl } from '../lib/catalog';
import { GUIDES } from '../lib/guides';
import { guideUrl, SITE, route } from '../lib/site';
import { HOME_SOLUTIONS, solutionsHubUrl } from '../lib/solutions';
import type { Locale } from '../lib/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isIt = locale === 'it';
const r = route(locale);
const featured = HOME_FEATURED_PRODUCTS;
const heroImages = new Map([
  ['FM-5201', hero5201],
  ['FM-5204', hero5204],
  ['FM-MP-8144', heroMP8144],
]);
const heroProducts = HOME_HERO_PRODUCTS.map((product) => {
  const heroImage = heroImages.get(product.sku);
  if (!heroImage) throw new Error(`Immagine hero non trovata: ${product.sku}`);
  return { ...product, heroImage };
});
const title = isIt ? 'Attrezzature professionali per palestre | FullMuscle' : 'Professional gym equipment | FullMuscle';
const description = isIt ? 'Forniture complete di attrezzature per aprire o rinnovare una palestra in Italia: sala pesi, cardio, functional e preventivo dedicato.' : 'Complete equipment supplies for new gyms and renovations in Italy: strength, cardio and functional training with a tailored quotation.';
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'FullMuscle Equipment', legalName: SITE.legalName || 'FullMuscle Equipment', url: new URL('/', Astro.site), logo: new URL('/brand/fullmuscle-mark.svg', Astro.site),
  ...(SITE.email ? { email: SITE.email } : {}), ...(SITE.phone ? { telephone: SITE.phone } : {}),
  ...(SITE.address ? { address: { '@type': 'PostalAddress', streetAddress: SITE.address, addressLocality: SITE.city, addressCountry: 'IT' } } : {}),
  ...(SITE.socialUrls.length ? { sameAs: SITE.socialUrls } : {}),
};
---
<BaseLayout locale={locale} title={title} description={description} canonicalPath={r.home} alternateUrl={route(isIt ? 'en' : 'it').home} xDefaultUrl="/" structuredData={organization}>
  <section class="home-hero surface-dark">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">FullMuscle Equipment</p>
        <h1 class="display">{isIt ? <>Apri o rinnova la tua palestra con una <em>fornitura completa.</em></> : <>Open or upgrade your gym with a <em>complete equipment supply.</em></>}</h1>
        <p class="lead">{isIt ? 'Sala pesi, cardio e functional: costruiamo la dotazione della tua palestra in Italia, partendo da spazi, obiettivi e budget.' : 'Strength, cardio and functional training: we build the equipment mix for your gym in Italy around your space, goals and budget.'}</p>
        <div class="hero-actions cluster">
          <a class="button" href={`${r.quote}?project=gym`}>{isIt ? 'Richiedi una fornitura completa' : 'Request a complete equipment supply'} <span>→</span></a>
          <a class="button button-secondary" href={r.catalog}>{isIt ? 'Esplora il catalogo' : 'Explore catalogue'}</a>
        </div>
      </div>
      <div class="hero-stage" aria-label={isIt ? 'Selezione di attrezzature FullMuscle' : 'FullMuscle equipment selection'}>
        <div class="hero-orbit" aria-hidden="true"></div>
        <div class="hero-composition">
          {heroProducts.map((product, index) => <a href={`${r.products}/${product.slug[locale]}/`} class={`hero-machine machine-${index + 1}`} aria-label={`${isIt ? 'Scopri' : 'Explore'} ${product.name[locale]}`}>
            <Image
              src={product.heroImage}
              alt={product.imageAlt[locale]}
              format="webp"
              widths={[240, 400, 640, 900, 1200]}
              sizes={index === 0
                ? '(max-width: 360px) calc(100vw - 2rem), (max-width: 680px) 320px, (max-width: 900px) 560px, (max-width: 1280px) 40vw, 500px'
                : '(max-width: 520px) calc(50vw - 1.375rem), (max-width: 680px) 240px, (max-width: 900px) 330px, (max-width: 1280px) 24vw, 300px'}
              loading="eager"
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          </a>)}
        </div>
        <div class="hero-note"><strong>{PRODUCTS.length}</strong><span>{isIt ? 'modelli a catalogo' : 'catalogue models'}</span></div>
      </div>
    </div>
  </section>

  <section class="trust-strip surface-carbon">
    <div class="shell trust-grid">
      <div><strong>{CATEGORIES.length}</strong><span>{isIt ? 'categorie professionali' : 'professional categories'}</span></div>
      <div><strong>{LINES.length}</strong><span>{isIt ? 'linee di prodotto' : 'product lines'}</span></div>
      <div><strong>IT</strong><span>{isIt ? 'forniture in Italia' : 'equipment supplies in Italy'}</span></div>
      <div><strong>B2B</strong><span>{isIt ? 'preventivo dedicato' : 'tailored quotations'}</span></div>
    </div>
  </section>

  <section class="section surface-carbon home-solutions">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">{isIt ? 'Il tuo progetto' : 'Your project'}</p><h2 class="section-title">{isIt ? 'Una nuova apertura. Un rinnovo. La dotazione giusta.' : 'A new opening. An upgrade. The right equipment.'}</h2></div>
        <div><p>{isIt ? 'Forniture complete per nuove palestre, rinnovi e ampliamenti. Selezioni dedicate anche a centri medicali, fisioterapia e riabilitazione.' : 'Complete equipment supplies for new gyms, renovations and expansions. Dedicated selections for medical, physiotherapy and rehabilitation facilities too.'}</p><a class="text-link" href={solutionsHubUrl(locale)}>{isIt ? 'Scopri tutte le soluzioni' : 'Explore all solutions'} →</a></div>
      </div>
      <div class="home-solutions-grid">{HOME_SOLUTIONS.map((solution) => <SolutionCard solution={solution} locale={locale} {...(solution.id === 'medical' ? { sizes: '(max-width: 1280px) 100vw, 1240px' } : {})} />)}</div>
    </div>
  </section>

  <section class="section surface-dark solution-section">
    <div class="shell solution-grid">
      <div class="solution-copy">
        <p class="eyebrow">{isIt ? 'Dal progetto alla fornitura' : 'From project to equipment supply'}</p>
        <h2 class="section-title">{isIt ? 'Costruiamo insieme la dotazione della tua palestra.' : 'Build your gym’s equipment mix with us.'}</h2>
        <p class="lead">{isIt ? 'Per una nuova apertura valutiamo tutte le aree. Per un rinnovo partiamo dalle attrezzature da mantenere, sostituire e integrare. Il risultato è una proposta organizzata intorno al tuo progetto.' : 'For a new opening, we consider every training area. For a renovation, we start with equipment to keep, replace and add. The result is a proposal organised around your project.'}</p>
        <a class="button" href={`${r.quote}?project=gym`}>{isIt ? 'Parliamo della tua palestra' : 'Discuss your gym project'} →</a>
      </div>
      <ol class="process-list">
        <li><span>01</span><div><strong>{isIt ? 'Obiettivi e spazi' : 'Goals and space'}</strong><p>{isIt ? 'Raccogliamo metratura, pubblico, budget e tempi.' : 'We gather space, audience, budget and timeline.'}</p></div></li>
        <li><span>02</span><div><strong>{isIt ? 'Selezione attrezzature' : 'Equipment selection'}</strong><p>{isIt ? 'Bilanciamo cardio, forza, pesi liberi e functional.' : 'We balance cardio, strength, free weights and functional training.'}</p></div></li>
        <li><span>03</span><div><strong>{isIt ? 'Preventivo dedicato' : 'Tailored quotation'}</strong><p>{isIt ? 'Una proposta leggibile, costruita sul progetto reale.' : 'A clear proposal built around the actual project.'}</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">{isIt ? 'Il catalogo' : 'The catalogue'}</p><h2 class="section-title">{isIt ? 'Ogni area della palestra, una soluzione precisa.' : 'The right solution for every area of your gym.'}</h2></div>
        <p>{isIt ? 'Dalla sala pesi al cardio, organizza la ricerca per tipologia di attrezzatura e costruisci la tua richiesta.' : 'From strength to cardio, browse by equipment type and build a tailored request.'}</p>
      </div>
      <div class="grid grid-4 category-grid">
        {CATEGORIES.slice(0, 8).map((category) => <a class="taxonomy-card" href={taxonomyUrl(locale, category, 'category')}><strong>{category.name[locale]}</strong><p>{category.description[locale]}</p><span class="link-label">{isIt ? 'Scopri la categoria →' : 'Explore category →'}</span><span class="count">{category.count}</span></a>)}
      </div>
      <div class="center-action"><a class="button button-dark" href={r.catalog}>{isIt ? `Vedi tutti i ${PRODUCTS.length} prodotti` : `View all ${PRODUCTS.length} products`}</a></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">{isIt ? 'In evidenza' : 'Featured'}</p><h2 class="section-title">{isIt ? 'Una selezione dal catalogo.' : 'A selection from the catalogue.'}</h2></div></div>
      <div class="grid grid-3">{featured.slice(0, 6).map((product) => <ProductCard product={listItem(product, locale)} locale={locale} />)}</div>
    </div>
  </section>

  <section class="section-tight home-guides">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">{isIt ? 'Guide tecniche' : 'Technical guides'}</p><h2 class="section-title">{isIt ? 'Prima della macchina, viene la scelta.' : 'Make the right choices before selecting models.'}</h2></div><a class="text-link" href={`${r.guides}/`}>{isIt ? 'Tutte le guide' : 'All guides'} →</a></div>
      <div class="grid grid-3">{GUIDES.map((guide, index) => <a class="home-guide" href={guideUrl(locale, guide.slug[locale])}><span>0{index + 1} · {guide.readingTime} min</span><strong>{guide.title[locale]}</strong><p>{guide.description[locale]}</p></a>)}</div>
    </div>
  </section>

  <section class="section-tight final-cta">
    <div class="shell final-cta-inner">
      <div><p class="eyebrow">{isIt ? 'Nuove aperture e rinnovi' : 'New openings and renovations'}</p><h2>{isIt ? 'Raccontaci la palestra che vuoi realizzare.' : 'Tell us about the gym you want to create.'}</h2></div>
      <a class="button button-dark" href={`${r.quote}?project=gym`}>{isIt ? 'Richiedi un preventivo' : 'Request a quotation'} →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { min-height: min(860px, calc(100vh - 5rem)); overflow: hidden; }
  .hero-grid { display: grid; min-height: min(780px, calc(100vh - 5rem)); grid-template-columns: 1.05fr .95fr; align-items: center; gap: 2rem; }
  .hero-copy { position: relative; z-index: 2; padding: 5rem 0; }
  .hero-copy h1 { max-width: 14ch; font-size: clamp(2.8rem,5.3vw,5.2rem); line-height: 1; }
  h1 em { color: var(--green); font-style: normal; }
  .hero-actions { gap: .75rem; margin-top: 2rem; }
  .hero-actions .button { text-align: center; line-height: 1.3; }
  .hero-stage { position: relative; display: grid; gap: 1rem; min-width: 0; padding: 2rem 0; }
  .hero-composition { position: relative; min-height: 560px; }
  .hero-orbit { position: absolute; width: 100%; max-width: 570px; aspect-ratio: 1; top: 6%; left: 0; border: 1px solid rgba(105,190,40,.25); border-radius: 50%; box-shadow: 0 0 0 75px rgba(105,190,40,.025), 0 0 0 150px rgba(105,190,40,.018); pointer-events: none; }
  .hero-machine { position: absolute; display: block; border-radius: 1rem; filter: drop-shadow(0 28px 30px rgba(0,0,0,.45)); transition: transform .35s ease; }
  .hero-machine:hover { transform: translateY(-7px); }
  .hero-machine:focus-visible { z-index: 5; outline: 3px solid var(--green); outline-offset: 5px; }
  .hero-machine :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .machine-1 { z-index: 3; width: 82%; height: 62%; left: 9%; bottom: 0; }
  .machine-2 { z-index: 2; width: 49%; height: 45%; left: 0; top: 0; }
  .machine-3 { z-index: 2; width: 48%; height: 45%; right: 0; top: 1%; }
  .hero-note { position: relative; z-index: 4; justify-self: end; display: grid; padding: 1rem 1.15rem; border: 1px solid rgba(255,255,255,.14); border-radius: 1rem; background: rgba(9,12,10,.74); backdrop-filter: blur(16px); }
  .hero-note strong { color: var(--green); font-size: 2rem; line-height: 1; }
  .hero-note span { color: #aeb7b0; font-size: .7rem; }
  .trust-strip { border-top: 1px solid #242b25; }
  .trust-grid { display: grid; grid-template-columns: repeat(4,1fr); }
  .trust-grid div { display: grid; gap: .3rem; padding: 1.5rem; border-left: 1px solid #2c342e; }
  .trust-grid div:last-child { border-right: 1px solid #2c342e; }
  .trust-grid strong { color: var(--green); font-size: 1.35rem; }
  .trust-grid span { color: #9da69f; font-size: .74rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .section-heading > p { max-width: 42ch; color: var(--muted); }
  .category-grid { gap: .75rem; }
  .center-action { display: flex; justify-content: center; margin-top: 2.5rem; }
  .home-solutions .section-heading>div:last-child { max-width: 42ch; }
  .home-solutions .section-heading p:not(.eyebrow) { color: #aeb7b0; }
  .home-solutions .text-link { display: inline-block; margin-top: .75rem; color: var(--green); }
  .home-solutions-grid { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); gap: 1rem; }
  .home-solutions-grid > :global(.solution-card:nth-child(-n+2)) { grid-column: span 6; }
  .home-solutions-grid > :global(.solution-card:nth-child(3)) { grid-column: 1/-1; min-height: 19rem; }
  .home-solutions-grid > :global(.solution-card:nth-child(3) .solution-content strong) { max-width: 30ch; font-size: clamp(1.6rem,2.4vw,2.4rem); }
  .home-solutions-grid > :global(.solution-card:nth-child(3) img) { object-position: center 42%; }
  .solution-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem,8vw,8rem); align-items: center; }
  .solution-copy .button { margin-top: 1rem; }
  .process-list { margin: 0; padding: 0; list-style: none; }
  .process-list li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.5rem 0; border-top: 1px solid #303732; }
  .process-list li:last-child { border-bottom: 1px solid #303732; }
  .process-list > li > span { color: var(--green); font-size: .75rem; font-weight: 800; }
  .process-list strong { font-size: 1.2rem; }
  .process-list p { margin: .25rem 0 0; color: #9da69f; }
  .final-cta { background: var(--green); }
  .home-guides { background: #e9ede9; }
  .home-guide { display: grid;align-content:start;min-height:19rem;border-top:2px solid var(--green);padding:1.5rem;background:#fff;transition:transform .2s ease,box-shadow .2s ease; }
  .home-guide:hover { transform:translateY(-4px);box-shadow:var(--shadow); }
  .home-guide span { color:var(--green-dark);font-size:.72rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase; }
  .home-guide strong { margin-top:2.5rem;font-size:1.55rem;letter-spacing:-.035em;line-height:1.08; }
  .home-guide p { color:var(--muted);font-size:.9rem; }
  .final-cta .eyebrow { color: var(--ink); }
  .final-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .final-cta h2 { max-width: 19ch; margin: 0; font-size: clamp(2rem,5vw,4.2rem); letter-spacing: -.05em; line-height: 1; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { padding-bottom: 0; }
    .hero-copy h1 { max-width: 19ch; }
    .hero-stage { width: 100%; max-width: 680px; margin-inline: auto; padding-top: 0; }
    .hero-composition { min-height: 580px; }
    .solution-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .home-hero { min-height: auto; }
    .hero-grid { min-height: auto; }
    .hero-stage { padding-bottom: 1.5rem; }
    .hero-composition { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .75rem; align-items: end; min-height: 0; }
    .hero-machine { position: relative; inset: auto; width: 100%; height: auto; max-width: 240px; aspect-ratio: 1; justify-self: center; }
    .machine-1 { grid-column: 1/-1; max-width: 320px; }
    .hero-orbit { max-width: 450px; top: 8%; left: 50%; transform: translateX(-50%); }
    .trust-grid { grid-template-columns: 1fr 1fr; }
    .section-heading, .final-cta-inner { align-items: flex-start; flex-direction: column; }
    .home-solutions-grid { grid-template-columns: 1fr; }
    .home-solutions-grid > :global(.solution-card) { grid-column: auto!important; }
    .final-cta .button { width: auto; }
  }
</style>
